// Prepare private configuration for an explicitly supplied isolated runtime.
// Does not read the checkout's original .env or create/replace a database.
import { parseEnv } from 'node:util';
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import path from 'node:path';
try {
  if (!process.argv[2]) throw new Error('Explicit test runtime env file required');
  const input = parseEnv(readFileSync(path.resolve(process.argv[2]), 'utf8'));
  const local = url => ['localhost', '127.0.0.1', '[::1]'].includes(url.hostname);
  const database = new URL(input.DATABASE_URL || 'invalid:');
  const redis = new URL(input.REDIS_URL || 'invalid:');
  const judge = new URL(input.GO_JUDGE_API || 'invalid:');
  const base = new URL(input.NOVAJUDGE_URL || 'invalid:');
  if (input.REACTION_TEST_RUNTIME !== '1' || !local(database) || !['postgres:', 'postgresql:'].includes(database.protocol)
    || !/^\/reaction_e2e_[a-z0-9_]+$/.test(database.pathname)) throw new Error('Dedicated test database required');
  if (!local(redis) || !['redis:', 'rediss:'].includes(redis.protocol) || !/^\/[1-9]\d*$/.test(redis.pathname) || !local(judge) || judge.protocol !== 'http:'
    || !local(base) || base.protocol !== 'http:' || base.username || base.password || base.pathname !== '/' || base.search || base.hash) throw new Error('Local services required');
  if (!input.SUPER_ADMIN_USERNAME?.startsWith('reaction-e2e-') || !input.SUPER_ADMIN_PASSWORD || input.SUPER_ADMIN_PASSWORD.length < 16
    || !input.JWT_SECRET || input.JWT_SECRET.length < 32 || [input.SUPER_ADMIN_PASSWORD, input.JWT_SECRET].some(value => /CHANGE_ME|REPLACE_ME|^</i.test(value))) throw new Error('Explicit generated test credentials required');
  const runtime = { DATABASE_URL: database.href, REDIS_URL: redis.href, GO_JUDGE_API: judge.href, NOVAJUDGE_URL: base.origin,
    JWT_SECRET: input.JWT_SECRET, SUPER_ADMIN_USERNAME: input.SUPER_ADMIN_USERNAME, SUPER_ADMIN_PASSWORD: input.SUPER_ADMIN_PASSWORD,
    NODE_ENV: 'development', NOVAJUDGE_CLI_MODE: 'intranet', JUDGE_CONCURRENCY: '1', REACTION_TEST_RUNTIME: '1',
    REACTION_E2E_TEAM: input.REACTION_E2E_TEAM || 'team007' };
  if (!/^[A-Za-z0-9_-]{1,64}$/.test(runtime.REACTION_E2E_TEAM)) throw new Error('Test team username invalid');
  const target = '.local/reaction-e2e/runtime.env';
  if (existsSync(target)) {
    const existing = parseEnv(readFileSync(target, 'utf8'));
    if (Object.entries(runtime).some(([key, value]) => existing[key] !== value)) throw new Error('Existing runtime differs; preserve it and use another test checkout');
  } else writeFileSync(target, Object.entries(runtime).map(([key, value]) => key + '=' + JSON.stringify(value)).join('\n'), { mode: 0o600, flag: 'wx' });
  console.log(JSON.stringify({ base: base.origin, port: Number(base.port || 80) }));
} catch {
  console.error('Test runtime rejected. Supply an explicit env file: REACTION_TEST_RUNTIME=1, local reaction_e2e_* PostgreSQL database, isolated Redis, go-judge, NOVAJUDGE_URL, generated JWT_SECRET and reaction-e2e-* administrator credentials. Existing configuration is never overwritten.');
  process.exitCode = 1;
}
