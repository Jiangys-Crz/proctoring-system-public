import { promises as fs } from 'node:fs';
import path from 'node:path';
import { randomBytes } from 'node:crypto';
import bcrypt from 'bcryptjs';
import { prisma } from '../../lib/prisma';

const root = path.resolve('.local/reaction-e2e');
const fixturePath = path.join(root, 'fixture.private.json');
const base = new URL(process.env.NOVAJUDGE_URL!).origin;
const teamUsername = process.env.REACTION_E2E_TEAM || 'team007';
const fixtureLabel = 'Reaction E2E isolated fixture';
const action = process.argv[2] || 'init';
if (process.env.REACTION_TEST_RUNTIME !== '1' || !/^\/reaction_e2e_[a-z0-9_]+$/.test(new URL(process.env.DATABASE_URL!).pathname)) throw new Error('This helper requires its dedicated test database.');
async function post(route: string, body: unknown, headers: Record<string,string> = {}) {
  const r = await fetch(base + route, {method:'POST', headers:{'Content-Type':'application/json', Origin:base, ...headers}, body:JSON.stringify(body), signal:AbortSignal.timeout(60000)});
  const data = await r.json();
  if (!r.ok) throw new Error(`${route} HTTP ${r.status}: ${data.error || 'Request failed'}`);
  return data;
}
async function main() {
  await fs.mkdir(root,{recursive:true});
  if(action === 'init') {
    try {
      const old=JSON.parse(await fs.readFile(fixturePath,'utf8'));
      const contest=await prisma.contest.findUnique({where:{id:old.contestId}});
      if(contest?.title === fixtureLabel && old.teamUsername === teamUsername && old.base === base) {
        await prisma.contest.update({where:{id:old.contestId},data:{endTime:new Date(Date.now()+24*3600000),status:'RUNNING'}});
        console.log(JSON.stringify({contestId:old.contestId,team:old.teamUsername,problemId:old.problemId,reused:true})); return;
      }
    } catch(e) { if((e as any).code !== 'ENOENT') throw e; }
    const password=randomBytes(24).toString('base64url'),apiKey=randomBytes(32).toString('hex');
    const adminUsername=process.env.SUPER_ADMIN_USERNAME!, adminPassword=process.env.SUPER_ADMIN_PASSWORD!;
    const admin=await prisma.globalUser.upsert({where:{username:adminUsername},update:{},create:{username:adminUsername,password:await bcrypt.hash(adminPassword,10),role:'SUPER_ADMIN'}});
    await prisma.apiKey.create({data:{key:apiKey,name:'Reaction E2E integration',userId:admin.id}});
    const contest=await prisma.contest.create({data:{title:fixtureLabel,visible:false,status:'RUNNING',startTime:new Date(Date.now()-60000),endTime:new Date(Date.now()+24*3600000)}});
    const user=await prisma.user.create({data:{contestId:contest.id,username:teamUsername,displayName:'Reaction Test Team',school:'Test University',password:await bcrypt.hash(password,10)}});
    const problem=await prisma.problem.create({data:{id:1_000_000_000+randomBytes(4).readUInt32BE()%1_000_000_000,title:'Reaction E2E A+B',defaultTimeLimit:1000,defaultMemoryLimit:256,sections:[{title:'Description',content:'Read two integers and print their sum.'}],samples:[{input:'2 3',output:'5'}],judgeConfig:{type:'default',cases:[{input:'1.in',output:'1.out'},{input:'2.in',output:'2.out'}]}}});
    const dir=path.resolve('uploads/problems',String(problem.id));
    await fs.mkdir(dir); await fs.mkdir(path.join(dir,'data'));
    await fs.writeFile(path.join(dir,'data','1.in'),'2 3\n'); await fs.writeFile(path.join(dir,'data','1.out'),'5\n');
    await fs.writeFile(path.join(dir,'data','2.in'),'19 -8\n'); await fs.writeFile(path.join(dir,'data','2.out'),'11\n');
    await fs.writeFile(path.join(dir,'data','problem.yml'),'type: default\ncases:\n  - input: 1.in\n    output: 1.out\n  - input: 2.in\n    output: 2.out\n');
    await prisma.contestProblem.create({data:{contestId:contest.id,problemId:problem.id,displayId:'A',color:'#38bdf8'}});
    await prisma.cliSettings.upsert({where:{id:1},create:{id:1,activeContestId:contest.id},update:{activeContestId:contest.id}});
    await fs.writeFile(fixturePath,JSON.stringify({base,contestId:contest.id,userId:user.id,problemId:problem.id,teamUsername:user.username,teamPassword:password,adminUsername,adminPassword,apiKey},null,2));
    console.log(JSON.stringify({contestId:contest.id,team:user.username,problemId:problem.id,fixturePath}));
  } else if(action === 'submit') {
    const fixture=JSON.parse(await fs.readFile(fixturePath,'utf8'));
    const verdict=(process.argv[3] || 'AC').toUpperCase(); if(!['AC','WA'].includes(verdict)) throw new Error('Expected AC or WA');
    const login=await post('/api/cli/login',{username:fixture.teamUsername,password:fixture.teamPassword,contestId:fixture.contestId,loginSource:'PROCTORING'},{'x-api-key':fixture.apiKey});
    const code='#include <iostream>\nint main(){long long a,b;std::cin>>a>>b;std::cout<<'+(verdict==='AC'?'a+b':'a-b')+'<<"\\n";}\n';
    const result=await post('/api/cli/submit',{contestId:fixture.contestId,problem:'A',language:'cpp',code},{Authorization:`Bearer ${login.token}`,'x-novajudge-proctor-key':login.proctoringKey});
    console.log(JSON.stringify({event:'submitted',expected:verdict,...result.submission}));
    const deadline=Date.now()+120000;
    let sub=await prisma.submission.findUniqueOrThrow({where:{id:result.submission.id}});
    while(['PENDING','JUDGING'].includes(sub.verdict)&&Date.now()<deadline) {await new Promise(r=>setTimeout(r,500));sub=await prisma.submission.findUniqueOrThrow({where:{id:sub.id}});}
    const evidence={event:'judged',id:sub.id,displayId:sub.displayId,verdict:sub.verdict,submittedAt:sub.submittedAt,observedAt:new Date().toISOString(),errorMessage:sub.errorMessage};
    await fs.appendFile(path.join(root,'submissions.ndjson'),JSON.stringify(evidence)+'\n'); console.log(JSON.stringify(evidence));
    if(sub.verdict!==(verdict==='AC'?'ACCEPTED':'WRONG_ANSWER'))throw new Error('Unexpected verdict '+sub.verdict);
  } else if(action === 'status') {
    const fixture=JSON.parse(await fs.readFile(fixturePath,'utf8'));
    const rows=await prisma.submission.findMany({where:{contestId:fixture.contestId},select:{id:true,displayId:true,verdict:true,submittedAt:true,errorMessage:true},orderBy:{submittedAt:'asc'}});
    console.log(JSON.stringify({contestId:fixture.contestId,submissions:rows},null,2));
  } else throw new Error('Unknown action');
}
main().catch(e=>{console.error(e.message);process.exitCode=1}).finally(()=>prisma.$disconnect());
