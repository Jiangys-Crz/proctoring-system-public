# Docker Compose production configuration. Copy to .env and replace every CHANGE_ME.
# Backend HTTPS: proctoring.example.org -> host 4031 -> container 4031.
# Student HTTPS: proctorstu.example.org -> host/container 4032.
# RTMPS: proctorstream.example.org -> TCP 1936.
# WebRTC: proctorrtc.example.org -> TCP/UDP 8189.
# WHIP/WHEP signaling and authenticated HLS stay behind the backend HTTPS API.
PROCTOR_WEB_HOST_PORT=4031
PROCTOR_CLIENT_WEB_HOST_PORT=4032

# Optional Docker build mirrors. Defaults apply when these are omitted from .env.
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
# Backend dependency downloads try the fallback if the primary registry fails.
NPM_REGISTRY=https://registry.npmjs.org
NPM_FALLBACK_REGISTRY=https://registry.npmmirror.com

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=cwnupaa_proctoring
MYSQL_USER=cwnupaa_proctor
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
# Use the same password as MYSQL_PASSWORD; hex passwords avoid URL escaping.
DATABASE_URL=mysql://cwnupaa_proctor:CHANGE_ME_DB_PASSWORD@mysql:3306/cwnupaa_proctoring

APP_BASE_URL=https://proctoring.example.org
# First production startup only: set a unique password of at least 12 characters. Existing accounts are never reset.
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
MEDIA_URL_SECRET=CHANGE_ME_MEDIA_URL_SECRET
MEDIA_PUBLISH_SECRET=CHANGE_ME_MEDIA_PUBLISH_SECRET
PROCTOR_UPLOAD_DIR=./uploads
# Bound buffered uploads separately from CPU-heavy video decoding.
UPLOAD_MAX_CONCURRENT=4
UPLOAD_MATERIAL_MAX_CONCURRENT=2
MEDIA_VALIDATION_CONCURRENCY=2
DESKTOP_RELEASE_CHANNEL=public
PROCTOR_CONTEST_MOCK=0

MEDIA_RTMPS_PUBLIC_BASE=rtmps://proctorstream.example.org:1936
MEDIA_WEBRTC_ADDITIONAL_HOSTS=proctorrtc.example.org
MEDIA_AUTH_HTTP_ADDRESS=http://web:4031/api/media/auth
# Absolute paths on the Docker host, matching the stream domain.
# Replace with the actual Caddy-managed/exported certificate and private key paths.
MEDIA_TLS_CERT_PATH=/etc/letsencrypt/live/proctorstream.example.org/fullchain.pem
MEDIA_TLS_KEY_PATH=/etc/letsencrypt/live/proctorstream.example.org/privkey.pem

# Legacy login-ticket signing only; not needed for API-Key judging.
HYDRO_PROCTOR_SHARED_SECRET=
# API-Key and the actual Hydro service address can be saved in backend System Settings.
HYDRO_PROCTOR_API_KEY=
HYDRO_PROCTOR_PROBLEM_DOMAIN=Problems
# Optional trusted attachment storage origins, separated by commas.
HYDRO_FILE_ALLOWED_ORIGINS=
# Existing programming problem PID (or numeric docId) in the configured Hydro problem domain.
PUBLIC_TEST_PROBLEM_ID=A1
CWNUPAA_EXTERNAL_API_BASE=https://www.example.org/api
CWNUPAA_EXTERNAL_APP_KEY=

# Bound initial login work per server process; overflow responds with retryable 503.
LOGIN_MAX_CONCURRENT=8

# Optional external live relay. Enable with docker-compose.live-relay.yml.
# Separate from examination media. Signaling uses the backend's existing HTTPS.
LIVE_RELAY_AUTH_SECRET=CHANGE_ME_RANDOM_HEX_SECRET_AT_LEAST_32_CHARACTERS
LIVE_RELAY_ADDITIONAL_HOSTS=your-server-public-IP
LIVE_RELAY_ICE_PORT=1940
# Empty uses APP_BASE_URL; a separate origin must proxy backend API/static routes.
LIVE_RELAY_PUBLIC_BASE=
LIVE_RELAY_MAX_STREAMS=8
LIVE_RELAY_MAX_CONNECTIONS=16
