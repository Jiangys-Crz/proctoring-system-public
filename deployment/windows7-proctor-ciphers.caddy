# Import inside the TLS block of the LAN proctoring sites that use an RSA
# certificate. TLS 1.3 is unchanged. AEAD suites stay available for modern
# clients; Win7 Schannel needs the ECDHE_RSA AES-CBC suites for TLS 1.2.
# Do not apply this to unrelated sites or replace their certificates.
protocols tls1.2 tls1.3
ciphers TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA
