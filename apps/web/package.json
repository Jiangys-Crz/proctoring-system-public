    "test:alerts:acknowledgement:http": "tsx tests/alert-acknowledgement-http-integration.ts",
    "test:security:attachments": "tsx tests/attachment-browser-integration.ts",
    "test:security:pairing": "tsx tests/pairing-security-integration.ts"
