  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@cwnupaa/proctor-shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "hls.js": "^1.7.0",
    "jszip": "^3.10.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.31.0",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "0.35.5",
    "unified": "^11.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.13",
    "playwright-core": "^1.58.2",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
