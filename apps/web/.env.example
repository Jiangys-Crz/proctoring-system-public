DATABASE_URL="mysql://cwnupaa_proctor:CHANGE_ME_DB_PASSWORD@127.0.0.1:3307/cwnupaa_proctoring"
APP_BASE_URL="http://localhost:4031"
# 后台域名转发 /contest 和 /candidate 到考生网页；修改后重新构建后台。
PROCTOR_CLIENT_WEB_INTERNAL_BASE="http://127.0.0.1:4032"
# First production startup only: set a unique password of at least 12 characters. Existing accounts are never reset.
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_SECRET="replace-with-at-least-32-random-characters"
MEDIA_URL_SECRET="replace-with-another-random-media-url-secret"
CWNUPAA_EXTERNAL_API_BASE="https://www.example.org/api"
CWNUPAA_EXTERNAL_APP_KEY="replace-with-cwnupaa-app-key"
PROCTOR_UPLOAD_DIR="./uploads"
# 上传内存与视频解码 CPU 使用独立并发上限；无需更新客户端。
UPLOAD_MAX_CONCURRENT=4
UPLOAD_MATERIAL_MAX_CONCURRENT=2
MEDIA_VALIDATION_CONCURRENCY=2
HYDRO_PROCTOR_SHARED_SECRET="replace-with-hydro-plugin-secret"
# API-Key 由监考后台的系统设置生成并保存到数据库。环境变量仅兼容旧部署。
HYDRO_PROCTOR_API_KEY=""
# 数据库系统设置优先；以下用于尚未保存配置时的默认值。
HYDRO_PROCTOR_PUBLIC_URL="http://localhost"
HYDRO_PROCTOR_PROBLEM_DOMAIN="Problems"
# 系统测试使用题库域中已有的编程题（题号 PID 或数字 docId），修改后重启后台。
PUBLIC_TEST_PROBLEM_ID="A1"
HYDRO_PROCTOR_JUDGE_ACCOUNT="proctor-judge"
MEDIA_WHIP_INTERNAL_BASE="http://127.0.0.1:8889"
# 生产构建监考网页时填写，例如 https://media.example.org；本地留空时使用当前主机 8080 端口。
NEXT_PUBLIC_MEDIA_HLS_BASE=""
# Optional local programming-submission syntax comparison capacity.
# CODE_CHECK_MAX_SUBMISSIONS=10000
# CODE_CHECK_MAX_CODE_BYTES=262144
# CODE_CHECK_MAX_TOTAL_BYTES=134217728
# CODE_CHECK_MAX_GROUP_SIZE=80
# CODE_CHECK_MAX_VERSION_PAIRS=1000000
# CODE_CHECK_MAX_RESULT_PAIRS=100000
# CODE_CHECK_WORKER_HEAP_MB=512
# CODE_CHECK_TIMEOUT_SECONDS=180

MEDIA_RTMPS_PUBLIC_BASE="rtmps://proctorstream.example.org:1936"
MEDIA_PUBLISH_SECRET="replace-with-another-random-publish-secret"
# Compose TLS certificate/key paths. Never commit private keys.
# MEDIA_TLS_CERT_PATH=/etc/letsencrypt/live/proctorstream.example.org/fullchain.pem
# MEDIA_TLS_KEY_PATH=/etc/letsencrypt/live/proctorstream.example.org/privkey.pem
# Per-session recording quota: 16 GiB by default; pairing materials: 100 MiB.
# UPLOAD_SESSION_QUOTA_BYTES=17179869184
# HYDRO_FILE_ALLOWED_ORIGINS=https://trusted-storage.example.org

# Download homepage: public or intranet; intranet updates never use the Internet.
DESKTOP_RELEASE_CHANNEL="public"
# Persistent installer storage, default: uploads/desktop-releases (within the Docker upload volume).
# DESKTOP_RELEASE_DIR=/app/apps/web/uploads/desktop-releases
# Media control API for test stream verification; private network / loopback only.
# MEDIA_API_INTERNAL_BASE=http://127.0.0.1:9997

# Reaction 自动录像：开启前由部署者在 apps/web/.env 取消下列三行注释并填写。
# 完整步骤：docs/reaction-ccs-auth.md。当前没有后台账号密码输入框。
# 使用 NovaJudge 全局超级管理员（SUPER_ADMIN）的账号密码，不是监考后台账号，
# 也不是比赛内管理员、外榜 x-api-key、直播 API Key 或浏览器登录 Cookie。
# 默认三项供同一 NovaJudge origin 的所有新考试复用，不必逐比赛重新授权。
# origin 只含协议+域名+端口，不含 /contest/14 或 /api；须与考试平台地址严格一致。
# 本机示例 http://127.0.0.1:3001；localhost 与 127.0.0.1 视为不同 origin。
# 保存后重启实际运行的 Reaction Recorder；Web 服务也须加载同一组配置。
# Docker/服务管理器需显式传入这些环境变量，仅改宿主机文件不会更新已有进程。
# 不提交含真实账号密码的 .env；非本机地址必须使用受信任的 HTTPS。
# REACTION_CCS_ORIGIN=https://judge.example.org
# REACTION_CCS_USERNAME=ccs-service-admin
# REACTION_CCS_PASSWORD="replace-with-the-existing-NovaJudge-account-password"
# 可选：单考试覆盖，优先于上述默认三项。键为监考考试内部 Exam.id（管理页URL中的ID），
# 不是10位考试编号，也不是NovaJudge比赛ID。错误覆盖项不会自动回退默认账号。
# 多主机时为每场指定对应origin；单主机通常只需默认三项。
# REACTION_CCS_CREDENTIALS={"EXAM_ID":{"origin":"https://judge.example.org","username":"service-admin","password":"..."}}
# REACTION_GENERATOR_PYTHON=/opt/reaction-venv/bin/python
# REACTION_GENERATOR_ROOT=/opt/reactions-generator
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Global organization badge settings: immutable historical assets also count.
# REACTION_BRANDING_MAX_ASSETS=2000
# Legacy shared-library read limits (new uploads use System settings).
# REACTION_LOGO_LIBRARY_MAX_ITEMS=500
# REACTION_LOGO_LIBRARY_MAX_PER_USER=100
