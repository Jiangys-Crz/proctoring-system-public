# HTTP control/auth calls go to web; video bytes go only to relay-media.
proxy_cache_path /var/cache/nginx/relay-auth levels=1:2 keys_zone=relay_auth:1m max_size=8m inactive=5s;
limit_conn_zone $server_name zone=relay_total:1m;
limit_req_zone $binary_remote_addr zone=relay_requests:1m rate=100r/s;
server {
    listen 8080;
    server_name _;
    access_log off;
    error_log /dev/stderr warn;
    server_tokens off;
    client_max_body_size 1k;
    keepalive_timeout 15s;
    send_timeout 10s;
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /_relay_auth {
        internal;
        set $relay_control http://web:4031;
        proxy_pass $relay_control/api/live-relay/access;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Relay-Internal "${LIVE_RELAY_AUTH_SECRET}";
        proxy_set_header X-Relay-Id $relay_stream;
        proxy_set_header X-Relay-Ticket $relay_ticket;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_connect_timeout 1s;
        proxy_read_timeout 4s;
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_cache relay_auth;
        proxy_cache_key "$relay_stream:$relay_ticket";
        proxy_cache_valid 204 2s;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 2s;
    }

    location ~ "^/relay-stream/(?<relay_ticket>[A-Za-z0-9_-]{1,900}[.][A-Za-z0-9_-]{43})/relay/(?<relay_stream>[A-Za-z0-9_-]{1,64})/(?<relay_asset>[A-Za-z0-9_-]+[.](?:m3u8|mp4|m4s|ts))$" {
        limit_except GET { deny all; }
        # Aggregate across viewers; do not use IP limits behind a shared gateway.
        limit_conn relay_total ${LIVE_RELAY_MAX_CONNECTIONS};
        limit_conn_status 429;
        limit_rate ${LIVE_RELAY_LIMIT_RATE};
        limit_req zone=relay_requests burst=100 nodelay;
        limit_req_status 429;
        auth_request /_relay_auth;
        set $relay_origin http://relay-media:8888;
        # CDN mode shares remuxing and emits relative paths without per-reader cookies.
        # The signed path is checked above; upstream credentials never reach viewers.
        proxy_pass $relay_origin/relay/$relay_stream/$relay_asset;
        proxy_set_header Authorization "Bearer ${LIVE_RELAY_AUTH_SECRET}";
        proxy_set_header Cookie "";
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Cache-Control;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "private, no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location / { return 404; }
}
