page {
  background: #eef2f7;
  color: #18202d;
  font-family: -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid #d7deea;
  border-radius: 12rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.muted {
  color: #637083;
  font-size: 26rpx;
}

.field {
  display: block;
  margin-top: 18rpx;
  color: #637083;
  font-size: 26rpx;
}

input,
picker {
  display: block;
  margin-top: 8rpx;
  min-height: 76rpx;
  border: 1rpx solid #d7deea;
  border-radius: 10rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  color: #18202d;
  background: #ffffff;
}

button {
  border-radius: 10rpx;
  margin-top: 18rpx;
}

.primary {
  background: #155eef;
  color: white;
}

.danger {
  background: #c92a2a;
  color: white;
}

.preview {
  width: 100%;
  height: 360rpx;
  background: #101418;
  border-radius: 12rpx;
  overflow: hidden;
}

.camera {
  width: 100%;
  height: 100%;
}
