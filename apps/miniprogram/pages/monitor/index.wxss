.monitor-page {
  position: fixed;
  inset: 0;
  background: #000;
}

.camera {
  width: 100%;
  height: 100%;
}

.camera-placeholder {
  background: #111827;
}

.monitor-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 0.45));
  box-sizing: border-box;
  pointer-events: none;
}

.monitor-overlay button {
  pointer-events: auto;
}

.monitor-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  align-self: flex-start;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #f8fafc;
  font-size: 22rpx;
}

.status-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #10b981;
}

.status-dot.lock {
  background: #f59e0b;
}

.status-dot.off {
  background: #ef4444;
}

.status-text {
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flip-btn {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 22rpx;
  padding: 9rpx 18rpx;
}

.flip-btn[disabled] {
  opacity: 0.5;
}

.monitor-tips {
  align-self: center;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #e2e8f0;
  font-size: 20rpx;
}

.monitor-actions {
  display: flex;
  gap: 10rpx;
  align-self: center;
}

.monitor-actions button.small {
  font-size: 20rpx;
  padding: 7rpx 14rpx;
  margin: 0;
}

.lock-note,
.finish-note {
  align-self: center;
  padding: 10rpx 18rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  text-align: center;
}

.lock-note {
  background: rgba(255, 242, 242, 0.92);
  color: #c92a2a;
}

.finish-note {
  background: rgba(255, 248, 232, 0.92);
  color: #6f4b00;
}

.monitor-overlay .muted {
  align-self: center;
  color: #cbd5e1;
  font-size: 20rpx;
}
